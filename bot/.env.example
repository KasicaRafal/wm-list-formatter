# Discord bot credentials — copy to bot/.env and fill in real values.
# Never commit bot/.env or real tokens.

# Bot token from: Discord Developer Portal → Your App → Bot → Token → Reset Token / Copy
DISCORD_TOKEN=

# Application ID from: Discord Developer Portal → Your App → General Information → Application ID
CLIENT_ID=

# Optional. Server (guild) ID for instant slash-command registration while testing.
# Right-click your server icon in Discord (Developer Mode ON) → Copy Server ID
# Leave empty to register commands globally (can take up to ~1 hour to appear).
GUILD_ID=
